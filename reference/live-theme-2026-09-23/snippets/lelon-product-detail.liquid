{% doc %}
LELON reusable component.
@param {product} product - Shopify product.
@param {string} section_id - Unique section identifier.
@param {boolean} [quick] - Compact dialog layout.
@param {boolean} [show_dynamic_checkout] - Enable accelerated checkout when purchasable.
{% enddoc %}
{% assign variant = product.selected_or_first_available_variant %}{% assign main_image = variant.featured_image | default: product.featured_image %}{% assign form_id = 'ProductForm-' | append: section_id %}
{% assign can_buy = false %}{% if settings.prelaunch == false and variant.available and variant.price > 0 %}{% assign can_buy = true %}{% endif %}
<article class="product-detail{% if quick %} product-detail--quick{% endif %}" data-product data-prelaunch="{{ settings.prelaunch }}">
<div class="product-gallery"><div class="product-main-image">{% if main_image %}{{ main_image | image_url: width: 1600 | image_tag: class: 'product-featured-image', widths: '375, 550, 750, 1000, 1300, 1600', sizes: '(max-width: 767px) 100vw, 52vw', loading: 'eager', fetchpriority: 'high', data-featured-image: '' }}{% endif %}<p class="media-missing" data-media-missing hidden>{{ 'cinema.image_missing' | t }}</p></div>
{% if product.images.size > 1 %}<div class="product-thumbnails" aria-label="{{ 'cinema.view_image' | t }}">{% for image in product.images %}{% capture associated %}{% for candidate in product.variants %}{% assign image_color = image.alt | split: ' — ' | slice: 1 | first %}{% if candidate.featured_image.id == image.id or candidate.option1 == image_color %}{{ candidate.id }},{% endif %}{% endfor %}{% endcapture %}<button type="button" data-media-thumb data-variant-ids="{{ associated | strip }}" data-image="{{ image | image_url: width: 1600 }}" data-alt="{{ image.alt | default: product.title | escape }}" aria-label="{{ 'cinema.view_image' | t }} {{ forloop.index }}" aria-pressed="{% if image.id == main_image.id %}true{% else %}false{% endif %}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '72px' }}</button>{% endfor %}</div>{% endif %}
{% unless quick %}{% for media in product.media %}{% case media.media_type %}{% when 'model' %}<div class="product-model">{{ media | model_viewer_tag: image_size: '900x', reveal: 'interaction', toggleable: true }}<button type="button" class="text-link" data-model-reset>{% render 'lelon-icon', name: 'rotate-ccw' %}{{ 'cinema.model_reset' | t }}</button></div>{% when 'video' %}<div class="product-video">{{ media | video_tag: controls: true, preload: 'none', image_size: '900x', autoplay: false, loop: false }}</div>{% endcase %}{% endfor %}{% endunless %}
</div>
<div class="product-info"><p class="eyebrow">{% if product.tags contains 'lelon-signature' %}LELON SIGNATURE{% else %}LELON{% endif %}</p>{% if quick %}<h2>{{ product.title | escape }}</h2>{% else %}<h1>{{ product.title | escape }}</h1>{% endif %}<div class="product-price" data-current-price>{% render 'lelon-price', product: product, variant: variant %}</div>{% render 'lelon-countdown' %}
{% form 'product', product, id: form_id, class: 'product-form', data-product-form: '' %}<div class="field"><label for="Variant-{{ section_id }}">{{ 'cinema.color_variant' | t }}</label><select id="Variant-{{ section_id }}" name="id">{% for option in product.variants %}<option value="{{ option.id }}"{% if option.id == variant.id %} selected{% endif %}>{{ option.title | escape }}{% unless option.available %}{% unless settings.prelaunch %} — {{ 'cinema.soldout' | t }}{% endunless %}{% endunless %}</option>{% endfor %}</select></div>
{% if product.variants.size > 1 and product.variants.size < 12 %}<div class="variant-buttons" role="group" aria-label="{{ 'cinema.color_variant' | t }}">{% for option in product.variants %}<button type="button" class="variant-chip" data-select-variant="{{ option.id }}" aria-pressed="{% if option.id == variant.id %}true{% else %}false{% endif %}">{{ option.title | escape }}</button>{% endfor %}</div>{% endif %}
<div class="field quantity-field"{% if settings.prelaunch %} hidden{% endif %}><label for="Quantity-{{ section_id }}">{{ 'cinema.quantity' | t }}</label><input id="Quantity-{{ section_id }}" type="number" name="quantity" min="1" step="1" value="1" inputmode="numeric"></div><p class="form-error" data-form-error role="alert" tabindex="-1" hidden></p>
<button type="submit" class="button button--full" data-buy{% unless can_buy %} disabled{% endunless %}><span data-buy-label>{% if can_buy %}{{ 'cinema.available' | t }}{% elsif settings.prelaunch or variant.price == 0 %}{{ 'cinema.prelaunch' | t }}{% else %}{{ 'cinema.soldout' | t }}{% endif %}</span>{% render 'lelon-icon', name: 'arrow-up-right' %}</button>
{% if can_buy and show_dynamic_checkout %}<div data-dynamic-checkout>{{ form | payment_button }}</div>{% endif %}
{% endform %}
{% if settings.prelaunch %}<p class="availability-note">{{ 'cinema.prelaunch_note' | t }}</p>{% endif %}
{% unless product.tags contains 'lelon-signature' %}{% unless quick %}{% render 'lelon-duo', id: section_id %}{% endunless %}{% endunless %}<div class="product-accordions">{% if product.description != blank %}<details open><summary>{{ 'cinema.product_details' | t }}{% render 'lelon-icon', name: 'plus' %}</summary><div class="rte">{{ product.description }}</div></details>{% endif %}{% assign has_specs = false %}{% if product.metafields.custom.material != blank or product.metafields.custom.lining != blank or product.metafields.custom.dimensions != blank or product.metafields.custom.carry != blank or product.metafields.custom.structure != blank or product.metafields.custom.interior != blank or product.metafields.custom.strap != blank %}{% assign has_specs = true %}{% endif %}{% if has_specs %}<details><summary>{{ 'cinema.technical_details' | t }}{% render 'lelon-icon', name: 'plus' %}</summary><dl class="product-specs">{% if product.metafields.custom.material != blank %}<div><dt>{{ 'cinema.material' | t }}</dt><dd>{{ product.metafields.custom.material | metafield_text }}</dd></div>{% endif %}{% if product.metafields.custom.lining != blank %}<div><dt>{{ 'cinema.lining' | t }}</dt><dd>{{ product.metafields.custom.lining | metafield_text }}</dd></div>{% endif %}{% if product.metafields.custom.dimensions != blank %}<div><dt>{{ 'cinema.dimensions' | t }}</dt><dd>{{ product.metafields.custom.dimensions | metafield_text }}</dd></div>{% endif %}{% if product.metafields.custom.carry != blank %}<div><dt>{{ 'cinema.carry' | t }}</dt><dd>{{ product.metafields.custom.carry | metafield_text }}</dd></div>{% endif %}{% if product.metafields.custom.structure != blank %}<div><dt>{{ 'cinema.structure' | t }}</dt><dd>{{ product.metafields.custom.structure | metafield_text }}</dd></div>{% endif %}{% if product.metafields.custom.interior != blank %}<div><dt>{{ 'cinema.interior' | t }}</dt><dd>{{ product.metafields.custom.interior | metafield_text }}</dd></div>{% endif %}{% if product.metafields.custom.strap != blank %}<div><dt>{{ 'cinema.strap' | t }}</dt><dd>{{ product.metafields.custom.strap | metafield_text }}</dd></div>{% endif %}</dl></details>{% endif %}{% if product.metafields.custom.care != blank %}<details><summary>{{ 'cinema.care' | t }}{% render 'lelon-icon', name: 'plus' %}</summary><div class="rte">{{ product.metafields.custom.care | metafield_tag }}</div></details>{% endif %}<details><summary>{{ 'cinema.shipping' | t }}{% render 'lelon-icon', name: 'plus' %}</summary><div class="rte">{% if shop.shipping_policy.body != blank %}{{ shop.shipping_policy.body }}{% else %}<p>{{ 'cinema.shipping_pending' | t }}</p>{% endif %}</div></details><details><summary>{{ 'cinema.returns' | t }}{% render 'lelon-icon', name: 'plus' %}</summary><div class="rte">{% if shop.refund_policy.body != blank %}{{ shop.refund_policy.body }}{% else %}<p>{{ 'cinema.returns_pending' | t }}</p>{% endif %}</div></details></div>
{% if quick %}<a class="text-link" href="{{ product.url }}">{{ 'cinema.open_product' | t }}{% render 'lelon-icon', name: 'arrow-up-right' %}</a>{% endif %}
</div>
{% unless quick %}<div class="product-sticky"><div><strong>{{ product.title | escape }}</strong><span data-current-price>{% render 'lelon-price', product: product, variant: variant, compact: true %}</span></div><button type="submit" form="{{ form_id }}" class="button" data-buy{% unless can_buy %} disabled{% endunless %}><span data-buy-label>{% if can_buy %}{{ 'cinema.available' | t }}{% elsif settings.prelaunch or variant.price == 0 %}{{ 'cinema.prelaunch' | t }}{% else %}{{ 'cinema.soldout' | t }}{% endif %}</span></button></div>{% endunless %}
<script type="application/json" data-product-json>{"title":{{ product.title | json | replace: '<', '\u003c' }},"variants":[{% for option in product.variants %}{"id":{{ option.id | json }},"title":{{ option.title | json | replace: '<', '\u003c' }},"available":{{ option.available | json }},"price":{{ option.price | json }},"price_formatted":{{ option.price | money | json }},"image":{% if option.featured_image %}{{ option.featured_image | image_url: width: 1600 | json }}{% elsif product.variants.size == 1 and product.featured_image %}{{ product.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %},"alt":{{ option.featured_image.alt | default: product.title | json | replace: '<', '\u003c' }},"media_id":{{ option.featured_media.id | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}</script>
</article>
