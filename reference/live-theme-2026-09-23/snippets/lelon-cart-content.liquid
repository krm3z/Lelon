{% doc %}
LELON reusable component.

{% enddoc %}
<div data-cart-content>{% if cart.item_count > 0 %}<div class="cart-lines">{% for item in cart.items %}<article class="cart-line" data-cart-line><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '88px' }}{% endif %}</a><div class="cart-line-info"><a class="cart-product-name" href="{{ item.url }}">{{ item.product.title | escape }}</a>{% unless item.product.has_only_default_variant %}<p class="product-note">{{ item.variant.title | escape }}</p>{% endunless %}<p>{{ item.final_price | money }} / unité · {{ item.final_line_price | money }}</p>{% for allocation in item.line_level_discount_allocations %}<p class="cart-applied-discount">{{ allocation.discount_application.title | escape }} : −{{ allocation.amount | money }}</p>{% endfor %}<div class="quantity-control"><button class="icon-button" type="button" data-cart-change data-key="{{ item.key | escape }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cinema.decrease' | t }} — {{ item.product.title | escape }}">{% render 'lelon-icon', name: 'minus' %}</button><span aria-label="{{ 'cinema.quantity' | t }}">{{ item.quantity }}</span><button class="icon-button" type="button" data-cart-change data-key="{{ item.key | escape }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cinema.increase' | t }} — {{ item.product.title | escape }}">{% render 'lelon-icon', name: 'plus' %}</button></div><button class="remove-line" type="button" data-cart-change data-key="{{ item.key | escape }}" data-quantity="0">{{ 'cinema.remove' | t }}</button></div></article>{% endfor %}</div><div class="cart-summary">{% if cart.total_discount > 0 %}<p class="cart-applied-discount">Réductions appliquées par Shopify : {{ cart.total_discount | money }}</p>{% endif %}<div class="subtotal"><span>{{ 'cinema.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>{% if settings.prelaunch %}<p>{{ 'cinema.payment_closed' | t }}</p>{% else %}<p class="product-note">{{ 'cinema.cart_note' | t }}</p><form action="{{ routes.cart_url }}" method="post"><button class="button button--full" name="checkout" type="submit">{{ 'cinema.checkout' | t }}{% render 'lelon-icon', name: 'arrow-up-right' %}</button></form>{% endif %}</div>{% else %}<div class="cart-empty"><img src="{{ 'lelon-rose.webp' | asset_url }}" alt="" width="80" height="96"><p>{{ 'cinema.cart_empty' | t }}</p><a class="button button--outline" href="{{ routes.all_products_collection_url }}">{{ 'cinema.continue_shopping' | t }}</a></div>{% endif %}</div>
