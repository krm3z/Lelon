{% doc %}
LELON reusable component.

{% enddoc %}
{% assign story_url = settings.story_url | default: '/pages/notre-histoire' %}{% assign contact_url = settings.contact_url | default: '/pages/contact' %}
{% assign contact_email = settings.contact_email | default: 'contact@lelon.fr' %}
<dialog id="MobileMenu" class="mobile-menu-dialog" aria-label="{{ 'cinema.navigation' | t }}"><div class="dialog-heading"><a class="brand" href="{{ routes.root_url }}">LELON</a><button class="icon-button" type="button" data-dialog-close aria-label="{{ 'cinema.close' | t }}">{% render 'lelon-icon', name: 'x' %}</button></div><nav class="mobile-menu-nav"><a href="{{ settings.main_collection.url | default: routes.all_products_collection_url }}">{{ 'cinema.collection' | t }}</a><a href="{% if settings.signature_collection %}{{ settings.signature_collection.url }}{% else %}{{ routes.root_url }}#signature{% endif %}">{{ 'cinema.signature' | t }}</a><a href="{{ story_url }}">{{ 'cinema.story' | t }}</a><a href="{{ contact_url }}">{{ 'cinema.contact' | t }}</a><a href="{{ routes.search_url }}">{{ 'cinema.search' | t }}</a><a href="{{ routes.account_url }}">{{ 'cinema.account' | t }}</a></nav><div class="mobile-menu-contact"><a href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}</a>{% if settings.instagram != blank %}<a href="{{ settings.instagram }}" target="_blank" rel="noopener noreferrer">Instagram · @lelon_officiel</a>{% endif %}{% if settings.tiktok != blank %}<a href="{{ settings.tiktok }}" target="_blank" rel="noopener noreferrer">TikTok · @lelon_officiel</a>{% endif %}</div></dialog>
<dialog id="SearchDialog" class="search-dialog" aria-labelledby="SearchTitle"><div class="dialog-heading"><h2 id="SearchTitle">{{ 'cinema.search' | t }}</h2><button class="icon-button" type="button" data-dialog-close aria-label="{{ 'cinema.close' | t }}">{% render 'lelon-icon', name: 'x' %}</button></div><form action="{{ routes.search_url }}" method="get" role="search" data-predictive-search><div class="field"><label for="HeaderSearch">{{ 'cinema.search_query' | t }}</label><input type="search" name="q" id="HeaderSearch" autocomplete="off" aria-controls="PredictiveSearchResults" aria-expanded="false" required></div><div id="PredictiveSearchResults" class="predictive-results" role="status" aria-live="polite"></div><button class="button" type="submit">{{ 'cinema.search_go' | t }}</button></form></dialog>
<dialog id="QuickView" class="quick-dialog" aria-label="{{ 'cinema.quick_view' | t }}"><div class="dialog-heading"><span>{{ 'cinema.quick_view' | t }}</span><button class="icon-button" type="button" data-dialog-close aria-label="{{ 'cinema.close' | t }}">{% render 'lelon-icon', name: 'x' %}</button></div><div data-quick-content></div></dialog>
