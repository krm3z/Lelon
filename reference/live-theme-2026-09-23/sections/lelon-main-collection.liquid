<section class="section page-width{% if collection.handle == 'signature' %} collection-signature{% endif %}"><div class="collection-heading" data-reveal><p class="eyebrow">LELON{% if collection.handle == 'signature' %} SIGNATURE{% else %} · COLLECTION 01{% endif %}</p><h1>{% if collection.handle == 'signature' %}LELON<br><em>Signature.</em>{% else %}{{ collection.title | escape }}{% endif %}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% elsif collection.handle == 'signature' %}<div class="rte"><p>Une autre expression. Des lignes plus composées, révélées dans un chapitre plus intime de LELON.</p></div>{% else %}<div class="rte"><p>Des silhouettes pensées pour accompagner les mouvements du quotidien, chacune avec sa propre présence.</p></div>{% endif %}</div>
<form class="collection-toolbar" method="get" action="{{ collection.url }}"><span>{{ collection.products_count }} {{ 'cinema.results' | t }}</span>{% if collection.filters.size > 0 and collection.products_count > 12 %}<details class="filters"><summary>{{ 'cinema.filters' | t }}{% render 'lelon-icon', name: 'sliders-horizontal' %}</summary><div class="filter-options">{% for filter in collection.filters %}<fieldset><legend>{{ filter.label | escape }}</legend>{% case filter.type %}{% when 'boolean', 'list' %}{% for value in filter.values %}<label class="filter-choice"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>{{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>{{ filter.min_value.param_name | split: '.' | last }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" placeholder="0"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>{{ filter.max_value.param_name | split: '.' | last }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" placeholder="{{ filter.range_max | divided_by: 100.0 }}"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>{% endcase %}</fieldset>{% endfor %}</div></details>{% endif %}<div class="sort-field"><label for="SortBy">{{ 'cinema.sort' | t }}</label><select name="sort_by" id="SortBy">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></div><button class="text-link" type="submit">{{ 'cinema.apply' | t }}</button><a class="text-link" href="{{ collection.url }}">{{ 'cinema.clear' | t }}</a></form>
{% paginate collection.products by 24 %}{% if collection.products.size > 0 %}<div class="product-grid">{% for product in collection.products %}{% render 'lelon-product-card', product: product %}{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% else %}<div class="empty-state"><h2>{{ 'cinema.empty_collection' | t }}</h2><p>{{ 'cinema.empty_collection_copy' | t }}</p></div>{% endif %}{% endpaginate %}</section>
{% schema %}
{"name": "LELON · main-collection", "settings": []}
{% endschema %}
