<section class="section page-width"><div class="collection-heading"><p class="eyebrow">LELON</p><h1>{{ 'cinema.search' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-page-form"><label for="PageSearch">{{ 'cinema.search_query' | t }}</label><div class="input-row"><input id="PageSearch" type="search" name="q" value="{{ search.terms | escape }}" required><input type="hidden" name="type" value="product"><button class="button" type="submit">{{ 'cinema.search_go' | t }}</button></div></form></div>{% if search.performed %}{% paginate search.results by 24 %}{% if search.results_count > 0 %}<p>{{ search.results_count }} {{ 'cinema.results' | t }}</p><div class="product-grid">{% for product in search.results %}{% if product.object_type == 'product' %}{% render 'lelon-product-card', product: product %}{% endif %}{% endfor %}</div>{{ paginate | default_pagination }}{% else %}<p>{{ 'cinema.no_results' | t }}</p>{% endif %}{% endpaginate %}{% endif %}</section>
{% schema %}
{"name": "LELON · main-search", "settings": []}
{% endschema %}
