{% assign contact_email = settings.contact_email | default: 'contact@lelon.fr' %}
{% assign privacy_url = settings.privacy_url | default: shop.privacy_policy.url | default: '/pages/politique-de-confidentialite' %}
<section class="section page-width contact-page"><div class="contact-intro"><p class="eyebrow">{{ 'cinema.contact_eyebrow' | t }}</p><h1>{{ page.title | default: 'Contact' | escape }}</h1><p class="contact-lead">{{ 'cinema.contact_intro' | t }}</p><div class="contact-details"><a href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}</a>{% if settings.contact_phone != blank %}<a href="tel:{{ settings.contact_phone | remove: ' ' | escape }}">{{ settings.contact_phone | escape }}</a>{% endif %}{% if settings.business_address != blank %}<address>{{ settings.business_address | newline_to_br }}</address>{% endif %}{% if settings.support_hours != blank %}<p>{{ settings.support_hours | newline_to_br }}</p>{% endif %}</div>{% if page.content != blank %}<div class="rte">{{ page.content }}</div>{% endif %}</div><div class="contact-form-panel">{% form 'contact' %}{% if form.posted_successfully? %}<p class="form-success" role="status">{{ 'cinema.sent' | t }}</p>{% else %}{{ form.errors | default_errors }}<div class="contact-form-grid"><div class="field"><label for="ContactFirstName">{{ 'cinema.first_name' | t }}</label><input id="ContactFirstName" type="text" name="contact[Prénom]" autocomplete="given-name" value="{{ form['Prénom'] | escape }}"></div><div class="field"><label for="ContactLastName">{{ 'cinema.last_name' | t }}</label><input id="ContactLastName" type="text" name="contact[Nom]" autocomplete="family-name" value="{{ form['Nom'] | escape }}"></div></div><div class="field"><label for="ContactEmail">{{ 'cinema.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}"></div><div class="field"><label for="ContactPhone">{{ 'cinema.phone_optional' | t }}</label><input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}"></div><div class="field"><label for="ContactSubject">{{ 'cinema.subject' | t }}</label><select id="ContactSubject" name="contact[Sujet]"><option value="Commande">{{ 'cinema.subject_order' | t }}</option><option value="Produit">{{ 'cinema.subject_product' | t }}</option><option value="Livraison">{{ 'cinema.subject_shipping' | t }}</option><option value="Retour">{{ 'cinema.subject_return' | t }}</option><option value="Presse / partenariat">{{ 'cinema.subject_press' | t }}</option><option value="Autre">{{ 'cinema.subject_other' | t }}</option></select></div><div class="field"><label for="ContactMessage">{{ 'cinema.message' | t }}</label><textarea id="ContactMessage" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea></div><p class="form-privacy">{{ 'cinema.contact_privacy' | t }} <a href="{{ privacy_url }}">{{ 'cinema.privacy' | t }}</a>.</p><button class="button" type="submit">{{ 'cinema.send' | t }}{% render 'lelon-icon', name: 'arrow-up-right' %}</button>{% endif %}{% endform %}</div></section>
{% schema %}
{"name": "LELON · contact", "settings": []}
{% endschema %}
