{% assign featured = section.settings.product %}{% assign image = section.settings.image | default: featured.featured_image %}{% if image %}<section class="feature-story"><figure data-image-reveal>{{ image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1400', sizes: '(max-width: 767px) 100vw, 55vw' }}</figure><div class="story-copy" data-reveal><span class="story-index" aria-hidden="true">01</span><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}<br><em>{{ section.settings.subtitle | escape }}</em></h2><p>{{ section.settings.copy | escape }}</p>{% if featured %}<p class="story-product">{{ featured.title | escape }} · {% render 'lelon-price', product: featured %}</p>{% endif %}<a class="text-link" href="{{ featured.url | default: '#collection' }}">{{ 'cinema.explore' | t }}{% render 'lelon-icon', name: 'arrow-up-right' %}</a></div></section>{% endif %}
{% schema %}
{
  "name": "LELON · feature-story",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photographie réelle"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "UN SAC, UNE PRÉSENCE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Le détail qui"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "change l’allure."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Texte",
      "default": "Une silhouette qui accompagne votre style, et laisse toute la place à votre personnalité."
    }
  ],
  "presets": [
    {
      "name": "LELON · feature-story"
    }
  ]
}
{% endschema %}
