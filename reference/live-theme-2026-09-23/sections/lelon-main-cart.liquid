<section class="section page-width cart-page"><p class="eyebrow">LELON</p><h1>{{ 'cinema.cart' | t }}</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-lines">{% for item in cart.items %}<article class="cart-line">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '88px' }}</a>{% endif %}<div><h2 class="cart-product-name"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2><p>{{ item.variant.title | escape }}</p><p>{{ item.final_line_price | money }}</p><label for="CartQuantity-{{ forloop.index }}">{{ 'cinema.quantity' | t }}</label><input type="number" name="updates[]" id="CartQuantity-{{ forloop.index }}" min="0" value="{{ item.quantity }}"><a href="{{ item.url_to_remove }}">{{ 'cinema.remove' | t }}</a></div></article>{% endfor %}</div><div class="cart-summary"><div class="subtotal"><span>{{ 'cinema.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><button class="button button--outline" name="update" type="submit">{{ 'cinema.apply' | t }}</button>{% unless settings.prelaunch %}<button class="button" name="checkout" type="submit">{{ 'cinema.checkout' | t }}</button>{% else %}<p>{{ 'cinema.payment_closed' | t }}</p>{% endunless %}</div></form>{% else %}<div class="empty-state"><p>{{ 'cinema.cart_empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cinema.continue_shopping' | t }}</a></div>{% endif %}</section>
{% schema %}
{"name": "LELON · main-cart", "settings": []}
{% endschema %}
