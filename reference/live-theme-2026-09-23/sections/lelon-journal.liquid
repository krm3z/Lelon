<section class="section journal page-width">
  <div class="journal__heading" data-reveal><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2></div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}" target="_blank" rel="noopener noreferrer">{{ section.settings.link_label | escape }}{% render 'lelon-icon', name: 'arrow-up-right' %}</a>{% endif %}</div>
  <div class="journal__grid">
    {% for block in section.blocks %}
      {% if block.settings.image != blank %}<figure class="journal__item" data-image-reveal {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 650, 900', sizes: '(max-width: 767px) 50vw, 25vw', alt: block.settings.image.alt | default: block.settings.caption }}{% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}</figure>{% endif %}
    {% endfor %}
  </div>
  {% if section.settings.disclosure != blank %}<p class="journal__disclosure">{{ section.settings.disclosure | escape }}</p>{% endif %}
</section>
{% schema %}
{
  "name":"LELON · journal",
  "max_blocks":8,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Surtitre","default":"LELON — JOURNAL"},
    {"type":"text","id":"title","label":"Titre","default":"Suivez notre univers."},
    {"type":"text","id":"link_label","label":"Libellé du lien","default":"@lelon_officiel"},
    {"type":"url","id":"link","label":"Lien social"},
    {"type":"text","id":"disclosure","label":"Mention facultative","default":"Sélection éditoriale LELON — ces images ne constituent pas un flux Instagram en direct."}
  ],
  "blocks":[{"type":"image","name":"Image éditoriale","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Légende"}]}],
  "presets":[{"name":"LELON · journal","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]
}
{% endschema %}
