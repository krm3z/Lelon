{% assign story_url = settings.story_url | default: '/pages/notre-histoire' %}<section class="philosophy page-width" id="maison"><div class="philosophy-mark" data-reveal><img class="rose-mark" data-rose-bloom src="{{ 'lelon-rose.webp' | asset_url }}" alt="" width="100" height="120" loading="lazy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p></div><div class="philosophy-copy"><h2 data-reveal>{{ section.settings.title | escape }}</h2><blockquote data-reveal>{{ section.settings.philosophy | escape }}</blockquote><div class="philosophy-end"><p class="eyebrow">{{ section.settings.signature | escape }}</p><a class="text-link" href="{{ story_url }}">Notre histoire{% render 'lelon-icon', name: 'arrow-up-right' %}</a></div></div></section>
{% schema %}
{
  "name": "LELON · maison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "L’ESPRIT LELON"
    },
    {
      "type": "textarea",
      "id": "philosophy",
      "label": "Philosophie",
      "default": "Chaque femme possède sa propre manière de s’épanouir."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "L’art de s’épanouir."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "L’ALLURE VOUS APPARTIENT."
    }
  ],
  "presets": [
    {
      "name": "LELON · maison"
    }
  ]
}
{% endschema %}
