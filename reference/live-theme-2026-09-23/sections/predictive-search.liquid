{% if predictive_search.performed %}
  <div class="predictive-search-panel">
    {% if predictive_search.resources.products.size > 0 %}
      <ul role="listbox" aria-label="{{ 'cinema.predictive_results' | t }}">
        {% for product in predictive_search.resources.products limit: 4 %}
          <li role="option">
            <a href="{{ product.url }}">
              {% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '64px', alt: product.featured_image.alt | default: product.title }}{% endif %}
              <span><strong>{{ product.title | escape }}</strong><small>{{ product.price | money }}</small></span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>{{ 'cinema.no_results' | t }}</p>
    {% endif %}
  </div>
{% endif %}
{% schema %}
{"name":"Recherche prédictive","settings":[]}
{% endschema %}
