{% assign featured_collection = section.settings.collection | default: settings.main_collection %}
{% assign curated_products = section.settings.products %}
<section class="section page-width homepage-collection" id="collection"><div class="section-heading section-heading--editorial" data-reveal><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2><p class="section-deck">{{ section.settings.subtitle | escape }}</p></div><a class="text-link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ 'cinema.all_collection' | t }}{% render 'lelon-icon', name: 'arrow-up-right' %}</a></div>
{% if curated_products != blank %}<div class="product-grid product-grid--curated">{% for product in curated_products %}{% render 'lelon-product-card', product: product %}{% endfor %}</div>{% elsif featured_collection.products.size > 0 %}<div class="product-grid product-grid--curated">{% for product in featured_collection.products limit: 4 %}{% render 'lelon-product-card', product: product %}{% endfor %}</div>{% else %}<div class="empty-state"><h3>{{ 'cinema.empty_collection' | t }}</h3><p>{{ 'cinema.empty_collection_copy' | t }}</p></div>{% endif %}
</section>
{% schema %}
{
  "name": "LELON · collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Sélection éditoriale",
      "limit": 4
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "LA COLLECTION LELON"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Notre collection"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Trois sacs. Trois expressions."
    }
  ],
  "presets": [
    {
      "name": "LELON · collection"
    }
  ]
}
{% endschema %}
