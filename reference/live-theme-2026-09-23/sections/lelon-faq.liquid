<section class="section page-width faq-page"><header><p class="eyebrow">À VOS CÔTÉS</p><h1>{{ page.title | default: 'Questions fréquentes' | escape }}</h1>{% if page.content != blank %}<div class="rte">{{ page.content }}</div>{% endif %}</header><div class="faq-list">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}{% render 'lelon-icon', name: 'plus' %}</summary><div class="rte">{% if block.settings.answer != blank %}{{ block.settings.answer }}{% else %}<p><strong>{{ 'cinema.complete_before_publish' | t }}</strong></p>{% endif %}</div></details>{% endfor %}</div></section>
{% schema %}
{"name":"LELON · FAQ","blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Question à compléter"},{"type":"richtext","id":"answer","label":"Réponse"}]}],"presets":[{"name":"LELON · FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"}]}]}
{% endschema %}
