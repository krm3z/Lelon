{% if section.settings.image != blank %}
  <section class="lifestyle-story">
    <figure data-image-reveal>{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '480, 750, 1000, 1400, 1800, 2000', sizes: '100vw', alt: section.settings.image.alt | default: section.settings.title }}</figure>
    <div class="lifestyle-story__copy" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.title | escape }}</h2>
      <p>{{ section.settings.copy | escape }}</p>
      {% if section.settings.link != blank %}<a class="button button--light" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}{% render 'lelon-icon', name: 'arrow-up-right' %}</a>{% endif %}
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name":"LELON · grand récit",
  "settings":[
    {"type":"image_picker","id":"image","label":"Photographie réelle"},
    {"type":"text","id":"eyebrow","label":"Surtitre","default":"DES HISTOIRES À PORTER"},
    {"type":"text","id":"title","label":"Titre","default":"LELON, plus qu’un sac."},
    {"type":"textarea","id":"copy","label":"Texte","default":"Une silhouette accompagne un mouvement, un moment, une manière d’être soi."},
    {"type":"text","id":"link_label","label":"Libellé du lien","default":"Notre histoire"},
    {"type":"url","id":"link","label":"Lien"}
  ],
  "presets":[{"name":"LELON · grand récit"}]
}
{% endschema %}
