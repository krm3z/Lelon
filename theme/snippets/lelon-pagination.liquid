{% doc %}
  Accessible native pagination.

  @param {object} paginate - Paginate object.
{% enddoc %}
<nav class="pagination" aria-label="{{ 'lelon.pagination.label' | t }}">
  <ul role="list">
    {%- if paginate.previous -%}
      <li><a class="pagination__arrow" href="{{ paginate.previous.url }}" aria-label="{{ 'lelon.pagination.previous' | t }}">{% render 'lelon-icon', name: 'arrow-left' %}</a></li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}" aria-label="{{ 'lelon.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span aria-current="page">{{ part.title }}</span>
        {%- else -%}
          <span>{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if paginate.next -%}
      <li><a class="pagination__arrow" href="{{ paginate.next.url }}" aria-label="{{ 'lelon.pagination.next' | t }}">{% render 'lelon-icon', name: 'arrow-right' %}</a></li>
    {%- endif -%}
  </ul>
</nav>
