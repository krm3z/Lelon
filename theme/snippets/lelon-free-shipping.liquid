{% doc %}
  Factual free-shipping indicator based on the theme setting that mirrors the Shopify shipping rate.
  No countdown, no urgency. Hidden when the threshold is 0.
{% enddoc %}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign remaining_money = remaining | money
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
  endif
  if progress > 100
    assign progress = 100
  endif
-%}
{%- if threshold > 0 -%}
  <div class="free-shipping">
    <p>
      {%- if remaining > 0 -%}
        {{ 'lelon.cart.free_shipping_remaining' | t: amount: remaining_money }}
      {%- else -%}
        {% render 'lelon-icon', name: 'check' %}{{ 'lelon.cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <span class="free-shipping__bar" aria-hidden="true"><span style="--progress: {{ progress }}%"></span></span>
  </div>
{%- endif -%}
