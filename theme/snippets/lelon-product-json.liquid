{% doc %}
  Variant data consumed by the product script (options, real availability, prices, media).

  @param {product} product - Product.
{% enddoc %}
<script type="application/json" data-product-json>
  {
    "id": {{ product.id | json }},
    "title": {{ product.title | json }},
    "options": {{ product.options | json }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "compare": {{ variant.compare_at_price | json }},
          "priceHtml": {{ variant.price | money | json }},
          "compareHtml": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "media": {{ variant.featured_media.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
