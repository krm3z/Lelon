{% doc %}
  Open Graph and Twitter metadata. Product pages expose the real Shopify price only.

  @param {string} title - Resolved page title.
  @param {string} [description] - Resolved meta description.
{% enddoc %}
{%- liquid
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="LELON">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:locale" content="fr_FR">
{%- if description != blank %}
  <meta property="og:description" content="{{ description | strip_html | escape }}">
{%- endif %}
{%- if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: title | escape }}">
{%- endif %}
{%- if request.page_type == 'product' and product.price > 0 %}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html | escape }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title | escape }}">
{%- if description != blank %}
  <meta name="twitter:description" content="{{ description | strip_html | escape }}">
{%- endif %}
