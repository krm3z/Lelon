{% doc %}
  Cart lines shared by the drawer and the cart page. Works without JavaScript (remove links, quantity inputs on the cart page).

  @param {boolean} [compact] - Drawer layout (buttons only, no inputs).
{% enddoc %}
<ul class="cart-lines" role="list">
  {%- for item in cart.items -%}
    <li class="cart-line" data-cart-line data-key="{{ item.key }}">
      <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '96px', loading: 'lazy', alt: '' }}
        {%- endif -%}
      </a>
      <div class="cart-line__info">
        <p class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></p>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-line__variant">
            {%- for option in item.options_with_values -%}
              {{ option.name | escape }} : {{ option.value | escape }}{% unless forloop.last %} · {% endunless %}
            {%- endfor -%}
          </p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-line__variant">{{ property.first | escape }} : {{ property.last | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- for allocation in item.line_level_discount_allocations -%}
          <p class="cart-line__discount">{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</p>
        {%- endfor -%}

        <div class="cart-line__controls">
          {%- if compact -%}
            <div class="qty" role="group" aria-label="{{ 'lelon.cart.quantity_for' | t: title: item.product.title }}">
              <button type="button" class="qty__btn" data-line-change data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'lelon.cart.decrease' | t }}">{% render 'lelon-icon', name: 'minus' %}</button>
              <span class="qty__value" aria-live="polite">{{ item.quantity }}</span>
              <button type="button" class="qty__btn" data-line-change data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'lelon.cart.increase' | t }}">{% render 'lelon-icon', name: 'plus' %}</button>
            </div>
          {%- else -%}
            <label class="visually-hidden" for="CartQty-{{ forloop.index }}">{{ 'lelon.cart.quantity_for' | t: title: item.product.title }}</label>
            <input class="qty__input" id="CartQty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric" data-line-input>
          {%- endif -%}
          <a class="cart-line__remove" href="{{ item.url_to_remove }}" data-line-change data-quantity="0">{{ 'lelon.cart.remove' | t }}<span class="visually-hidden"> — {{ item.product.title | escape }}</span></a>
        </div>
      </div>
      <div class="cart-line__price">
        {%- if item.original_line_price > item.final_line_price -%}
          <s>{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
        {%- if item.quantity > 1 -%}
          {%- assign unit_price = item.final_price | money -%}
          <small>{{ 'lelon.cart.unit_price' | t: price: unit_price }}</small>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
