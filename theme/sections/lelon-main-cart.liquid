<section class="section page-width cart-page">
  <header class="page-head">
    <p class="eyebrow">LELON</p>
    <h1 class="page-head__title">{{ 'lelon.cart.title' | t }}</h1>
  </header>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid" data-cart-page>
      <div class="cart-page__lines">
        {% render 'lelon-cart-lines' %}
        <button type="submit" name="update" class="btn btn--ghost cart-page__update">{{ 'lelon.cart.update' | t }}</button>
      </div>
      <aside class="cart-page__summary" aria-label="{{ 'lelon.cart.summary' | t }}">
        {% render 'lelon-free-shipping' %}
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="cart-discounts" role="list">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <p class="cart-subtotal">
          <span>{{ 'lelon.cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </p>
        <p class="cart-note">{{ 'lelon.cart.shipping_note' | t }}</p>
        {%- if section.settings.show_note -%}
          <label class="field-label" for="CartNote">{{ 'lelon.cart.note_label' | t }}</label>
          <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
        {%- endif -%}
        <button type="submit" name="checkout" class="btn btn--primary btn--full">
          {% render 'lelon-icon', name: 'lock' %}{{ 'lelon.cart.checkout' | t }}
        </button>
        <ul class="reassurance-list" role="list">
          {%- if settings.shipping_summary != blank -%}<li>{% render 'lelon-icon', name: 'truck' %}<span>{{ settings.shipping_summary | escape }}</span></li>{%- endif -%}
          {%- if settings.returns_summary != blank -%}<li>{% render 'lelon-icon', name: 'return' %}<span>{{ settings.returns_summary | escape }}</span></li>{%- endif -%}
        </ul>
      </aside>
    </form>
  {%- else -%}
    <div class="cart-empty cart-empty--page">
      <p class="cart-empty__title">{{ 'lelon.cart.empty' | t }}</p>
      <a class="btn btn--primary" href="{{ settings.main_collection.url | default: routes.all_products_collection_url }}">{{ 'lelon.cart.discover' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "LELON · Panier",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Note de commande", "default": false }
  ]
}
{% endschema %}
