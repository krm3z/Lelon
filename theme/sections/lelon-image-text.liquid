{%- assign image = section.settings.image -%}
<section class="section image-text image-text--{{ section.settings.image_position }}{% if section.settings.tone == 'ivory' %} surface-ivory{% endif %}">
  <div class="page-width image-text__grid">
    <figure class="image-text__media" data-reveal="image">
      {%- if image != blank -%}
        {{ image | image_url: width: 1600 | image_tag: widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: image.alt | default: section.settings.title }}
      {%- elsif request.design_mode -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </figure>
    <div class="image-text__copy" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="display-2">{{ section.settings.title | escape | newline_to_br }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte image-text__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}{% render 'lelon-icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "04 · Récit éditorial",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photographie" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l’image",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Surface",
      "options": [
        { "value": "cream", "label": "Crème" },
        { "value": "ivory", "label": "Ivoire" }
      ],
      "default": "ivory"
    },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "LELON" },
    { "type": "textarea", "id": "title", "label": "Titre", "default": "Des histoires à porter." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un rendez-vous, une journée qui commence tôt, une soirée qui se prolonge. Chaque sac LELON accompagne ces moments sans jamais les définir.</p>" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Notre histoire" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "04 · Récit éditorial" }]
}
{% endschema %}
