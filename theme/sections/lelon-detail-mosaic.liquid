<section class="section detail-mosaic">
  <div class="page-width">
    <header class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.title | escape }}</h2>
    </header>
    <div class="mosaic mosaic--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- assign image = block.settings.image -%}
        {%- if image == blank and block.settings.product != blank -%}
          {%- assign position = block.settings.media_position | minus: 1 -%}
          {%- assign image = block.settings.product.media[position].preview_image -%}
        {%- endif -%}
        {%- if image != blank -%}
          <figure class="mosaic__item" {{ block.shopify_attributes }} data-reveal="image">
            {%- if block.settings.product != blank -%}<a href="{{ block.settings.product.url }}" class="mosaic__link">{%- endif -%}
            {{ image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 33vw, 50vw', loading: 'lazy', alt: image.alt | default: block.settings.caption }}
            {%- if block.settings.product != blank -%}</a>{%- endif -%}
            {%- if block.settings.caption != blank -%}
              <figcaption><span class="eyebrow">{{ block.settings.caption | escape }}</span>{% if block.settings.product != blank %}<span>{{ block.settings.product.title | escape }}</span>{% endif %}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "06 · Détails",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "PORTÉ · TEXTURE · DÉTAIL · SILHOUETTE · INTÉRIEUR" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Au plus près des détails." }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Détail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "product", "id": "product", "label": "Produit (lien + image de repli)" },
        { "type": "range", "id": "media_position", "label": "Position de la photo du produit", "min": 1, "max": 12, "step": 1, "default": 1 },
        { "type": "text", "id": "caption", "label": "Légende", "default": "Détail" }
      ]
    }
  ],
  "presets": [
    {
      "name": "06 · Détails",
      "blocks": [
        { "type": "detail", "settings": { "caption": "Porté" } },
        { "type": "detail", "settings": { "caption": "Texture" } },
        { "type": "detail", "settings": { "caption": "Détail" } },
        { "type": "detail", "settings": { "caption": "Silhouette" } },
        { "type": "detail", "settings": { "caption": "Intérieur" } }
      ]
    }
  ]
}
{% endschema %}
