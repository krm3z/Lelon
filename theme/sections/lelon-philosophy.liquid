<section class="section philosophy">
  <div class="page-width philosophy__inner">
    {%- if section.settings.show_rose -%}
      <div class="philosophy__rose" aria-hidden="true" data-reveal>
        {%- if settings.rose_image -%}
          {{ settings.rose_image | image_url: width: 240 | image_tag: widths: '120, 240', sizes: '96px', loading: 'lazy', alt: '' }}
        {%- else -%}
          <img src="{{ 'lelon-rose.webp' | asset_url }}" alt="" width="96" height="116" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <blockquote class="philosophy__quote" data-reveal>
      <p>{{ section.settings.quote | escape | newline_to_br }}</p>
    </blockquote>
    {%- if section.settings.text != blank -%}<p class="philosophy__text" data-reveal>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="link" href="{{ section.settings.link | default: settings.story_url | default: '/pages/notre-histoire' }}" data-reveal>{{ section.settings.link_label | escape }}{% render 'lelon-icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "07 · Philosophie",
  "settings": [
    { "type": "checkbox", "id": "show_rose", "label": "Rose LELON", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "L’ESPRIT LELON" },
    { "type": "textarea", "id": "quote", "label": "Citation", "default": "Chaque femme possède sa propre manière de s’épanouir." },
    { "type": "text", "id": "text", "label": "Texte", "default": "LELON ne définit pas la femme. LELON l’accompagne." },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "Notre histoire" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "07 · Philosophie" }]
}
{% endschema %}
