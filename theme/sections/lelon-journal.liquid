{%- liquid
  assign link = section.settings.link | default: settings.instagram
-%}
<section class="section journal">
  <div class="page-width">
    <header class="section-head section-head--split" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="section-head__title">{{ section.settings.title | escape }}</h2>
      </div>
      {%- if link != blank -%}
        <a class="link" href="{{ link }}" target="_blank" rel="noopener">{{ section.settings.link_label | escape }}{% render 'lelon-icon', name: 'arrow-up-right' %}<span class="visually-hidden"> — {{ 'lelon.a11y.new_window' | t }}</span></a>
      {%- endif -%}
    </header>
    <div class="journal__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <figure class="journal__item" {{ block.shopify_attributes }} data-reveal="image">
            {%- if block.settings.product != blank -%}<a href="{{ block.settings.product.url }}">{%- endif -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.caption }}
            {%- if block.settings.product != blank -%}</a>{%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.disclosure != blank -%}<p class="journal__note">{{ section.settings.disclosure | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "10 · Journal",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "LELON — JOURNAL" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Suivez notre univers." },
    { "type": "text", "id": "link_label", "label": "Libellé du lien", "default": "@lelon_officiel" },
    { "type": "url", "id": "link", "label": "Lien (sinon Instagram des réglages)" },
    { "type": "text", "id": "disclosure", "label": "Mention", "default": "Sélection éditoriale LELON — pas un flux Instagram en direct." }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "product", "id": "product", "label": "Produit lié (facultatif)" },
        { "type": "text", "id": "caption", "label": "Légende" }
      ]
    }
  ],
  "presets": [
    { "name": "10 · Journal", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }
  ]
}
{% endschema %}
