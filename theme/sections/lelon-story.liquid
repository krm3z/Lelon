<article class="story">
  <header class="story__opening page-width">
    <p class="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
    <h1 class="display-1" data-reveal>{{ page.title | default: 'Notre histoire' | escape }}</h1>
    {%- if section.settings.lead != blank -%}<p class="story__lead" data-reveal>{{ section.settings.lead | escape }}</p>{%- endif -%}
  </header>

  {%- if section.settings.image != blank -%}
    <figure class="story__image" data-reveal="image">
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', alt: section.settings.image.alt | default: '' }}
    </figure>
  {%- endif -%}

  <div class="story__manifesto page-width">
    <blockquote data-reveal><p>{{ section.settings.quote | escape | newline_to_br }}</p></blockquote>
  </div>

  <div class="story__chapters page-width">
    {%- for block in section.blocks -%}
      <section class="story__chapter" {{ block.shopify_attributes }} data-reveal>
        <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
        <h2 class="display-3">{{ block.settings.title | escape }}</h2>
        <div class="rte">{{ block.settings.text }}</div>
      </section>
    {%- endfor -%}
  </div>

  {%- assign content = page.content | strip_html | strip -%}
  {%- assign quote = section.settings.quote | strip -%}
  {%- if content != blank and content != quote -%}
    <div class="story__merchant page-width rte">{{ page.content }}</div>
  {%- endif -%}

  <footer class="story__closing page-width" data-reveal>
    <p class="display-3">{{ section.settings.closing | escape }}</p>
    <a class="btn btn--primary" href="{{ settings.main_collection.url | default: routes.all_products_collection_url }}">{{ 'lelon.story.cta' | t }}</a>
  </footer>
</article>

{% schema %}
{
  "name": "LELON · Notre histoire",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "LA MAISON" },
    { "type": "textarea", "id": "lead", "label": "Introduction", "default": "Une vision féminine de l’allure, née du mouvement, de l’expression et de la liberté d’être soi." },
    { "type": "image_picker", "id": "image", "label": "Photographie" },
    { "type": "textarea", "id": "quote", "label": "Phrase centrale", "default": "Chaque femme possède sa propre manière de s’épanouir." },
    { "type": "text", "id": "closing", "label": "Conclusion", "default": "Chaque femme écrit sa propre histoire. LELON l’accompagne." }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapitre",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "01" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Titre" },
        { "type": "richtext", "id": "text", "label": "Texte" }
      ]
    }
  ]
}
{% endschema %}
