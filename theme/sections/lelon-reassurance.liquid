<section class="section section--compact reassurance">
  <div class="page-width">
    <ul class="reassurance__list" role="list">
      {%- for block in section.blocks -%}
        <li class="reassurance__item" {{ block.shopify_attributes }}>
          {% render 'lelon-icon', name: block.settings.icon %}
          <div>
            <p class="reassurance__title">{{ block.settings.title | escape }}</p>
            {%- if block.settings.text != blank -%}<p class="reassurance__text">{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
          {%- if block.settings.link != blank -%}<a class="reassurance__link" href="{{ block.settings.link }}"><span class="visually-hidden">{{ block.settings.title | escape }}</span></a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "11 · Réassurance",
  "max_blocks": 4,
  "settings": [
    { "type": "paragraph", "content": "Uniquement des informations vérifiées dans vos réglages Shopify et vos politiques publiées." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "truck", "label": "Livraison" },
            { "value": "track", "label": "Suivi" },
            { "value": "return", "label": "Retour" },
            { "value": "mail", "label": "Contact" },
            { "value": "lock", "label": "Paiement" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Livraison en France" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "11 · Réassurance",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Livraison en France", "text": "0,99 € · offerte dès 90 €" } },
        { "type": "item", "settings": { "icon": "track", "title": "Suivi de commande", "text": "Numéro de suivi communiqué à l’expédition" } },
        { "type": "item", "settings": { "icon": "return", "title": "14 jours pour changer d’avis", "text": "Droit de rétractation" } },
        { "type": "item", "settings": { "icon": "mail", "title": "Une question ?", "text": "contact@lelon.fr" } }
      ]
    }
  ]
}
{% endschema %}
