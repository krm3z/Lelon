<section class="password">
  <p class="brand brand--large">LELON</p>
  <h1 class="display-3">{{ 'lelon.password.title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p class="password__message">{{ shop.password_message | escape }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'password__form' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label class="field-label" for="StorePassword">{{ 'lelon.password.label' | t }}</label>
    <div class="newsletter-form__row">
      <input id="StorePassword" type="password" name="password" autocomplete="current-password" required>
      <button type="submit" class="btn btn--primary">{{ 'lelon.password.enter' | t }}</button>
    </div>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "LELON · Mot de passe",
  "settings": []
}
{% endschema %}
