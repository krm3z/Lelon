<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>LELON</title>
    {{ 'lelon.css' | asset_url | stylesheet_tag }}
    {% style %}
      @font-face { font-family: 'LELON Serif'; src: url('{{ 'lelon-serif.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'LELON Sans'; src: url('{{ 'lelon-sans.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
      :root { --ivory: {{ settings.ivory }}; --cream: {{ settings.cream }}; --powder: {{ settings.powder_pink }}; --chocolate: {{ settings.chocolate }}; --ink: {{ settings.ink }}; --champagne: {{ settings.champagne }}; --beige: {{ settings.beige }}; --taupe: {{ settings.taupe }}; }
    {% endstyle %}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
